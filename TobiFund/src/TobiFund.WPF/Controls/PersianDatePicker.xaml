<UserControl x:Class="TobiFund.WPF.Controls.PersianDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- نمایش تاریخ (فقط خواندنی — قابل ویرایش نیست) -->
        <TextBox x:Name="DisplayBox"
                 Grid.Column="0"
                 Style="{StaticResource TextBoxStyle}"
                 IsReadOnly="True"
                 Margin="0"
                 VerticalContentAlignment="Center"
                 Cursor="Hand"
                 ToolTip="برای انتخاب تاریخ کلیک کنید"
                 MouseLeftButtonUp="DisplayBox_MouseLeftButtonUp" />

        <ToggleButton x:Name="DropButton"
                      Grid.Column="1"
                      Width="28"
                      Margin="2,0,0,0"
                      VerticalAlignment="Stretch"
                      Cursor="Hand"
                      Content="▼"
                      FontSize="9"
                      Click="DropButton_Click" />

        <!-- پاپ‌اپ انتخاب روز / ماه / سال شمسی -->
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=DropButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="انتخاب تاریخ (شمسی)"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="سال" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" />
                            <ComboBox x:Name="YearCombo" Width="90" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Part_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="ماه" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" />
                            <ComboBox x:Name="MonthCombo" Width="110" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Part_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="روز" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" />
                            <ComboBox x:Name="DayCombo" Width="70" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Part_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="PreviewText"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,8" />

                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                        <Button Content="امروز" Click="Today_Click" Margin="4,0" Padding="12,6" />
                        <Button Content="تأیید" Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0" Padding="14,6" />
                        <Button Content="انصراف" Click="Cancel_Click" Margin="4,0" Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
