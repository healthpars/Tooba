<Window x:Class="TobiFund.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سیستم — صندوق طوبی"
        Width="420" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource BackgroundBrush}" Padding="28">
        <Border Background="White" CornerRadius="14" Padding="24" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <!-- تصویر درخت طوبی بالای صفحه ورود -->
                <Image Source="/Assets/tobi-tree-logo.png" Width="140" Height="140" Margin="0,0,0,10" />
                <TextBlock Text="صندوق سرمایه‌گذاری طوبی"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="سامانه مدیریت صندوق وام و اعضا"
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,20" />

                <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource TextBoxStyle}" />

                <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,4" MinHeight="18" />

                <Button Content="ورود"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click"
                        IsDefault="True"
                        Margin="0,12,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />

                <TextBlock Text="نسخه ۱.۰.۰"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Border>
</Window>
