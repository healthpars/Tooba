<Application x:Class="TobiFund.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:TobiFund.WPF.Converters"
             xmlns:vm="clr-namespace:TobiFund.WPF.ViewModels"
             xmlns:views="clr-namespace:TobiFund.WPF.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- مبدل‌ها -->
            <cv:PersianDateConverter x:Key="PersianDate" />
            <cv:PersianNumberConverter x:Key="PersianNumber" />
            <cv:StatusTextConverter x:Key="StatusText" />
            <cv:IndexToVisibilityConverter x:Key="IndexToVisibility" />
            <cv:InverseBooleanConverter x:Key="InverseBoolean" />
            <cv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <cv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- نگاشت ViewModel به View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MembersViewModel}">
                <views:MembersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MemberDetailViewModel}">
                <views:MemberDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CapitalViewModel}">
                <views:CapitalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoansViewModel}">
                <views:LoansView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstallmentsViewModel}">
                <views:InstallmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubscriptionsViewModel}">
                <views:SubscriptionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RankingViewModel}">
                <views:RankingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <views:UsersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
