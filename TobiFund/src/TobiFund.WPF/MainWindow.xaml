<Window x:Class="TobiFund.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="صندوق سرمایه‌گذاری طوبی"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== منوی کناری ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,16,12,8">
                    <Image Source="/Assets/tobi-tree-logo.png" Width="72" Height="72" />
                    <TextBlock Text="صندوق طوبی" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CurrentUserRole}" Foreground="#C8E6C9" FontSize="12"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,4,8">
                        <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoDashboardCommand}">📊 داشبورد</Button>

                        <Expander Header="👥 اعضا" Style="{StaticResource ExpanderStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoMembersCommand}">لیست اعضا</Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoNewMemberCommand}">عضو جدید</Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="💰 سرمایه" Style="{StaticResource ExpanderStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoCapitalCommand}">پرداخت سرمایه / گردش سرمایه</Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="🏦 وام" Style="{StaticResource ExpanderStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoLoansCommand}">ثبت وام / لیست وام‌ها</Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoInstallmentsCommand}">اقساط</Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="🧾 آبونمان" Style="{StaticResource ExpanderStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoSubscriptionsCommand}">وضعیت / پرداخت آبونمان</Button>
                            </StackPanel>
                        </Expander>

                        <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoRankingCommand}">⭐ رتبه‌بندی اعضا</Button>
                        <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoReportsCommand}">📑 گزارش‌ها</Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoUsersCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">👤 کاربران</Button>
                        <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoSettingsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">⚙️ تنظیمات</Button>
                        <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoBackupCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">💾 پشتیبان‌گیری</Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="8,8,8,12">
                    <Border Background="{StaticResource SidebarHoverBrush}" CornerRadius="6" Padding="10" Margin="4,2">
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding GoChangePasswordCommand}">🔑 تغییر رمز عبور</Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding LogoutCommand}">🚪 خروج</Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== محتوای اصلی ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- هشدار تغییر رمز عبور پیش‌فرض -->
            <Border Grid.Row="0" Background="#FFF8E1" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="0,0,0,1" Padding="12,8"
                    Visibility="{Binding ShowDefaultPasswordWarning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ شما با رمز عبور پیش‌فرض وارد شده‌اید؛ لطفاً رمز عبور خود را تغییر دهید."
                               VerticalAlignment="Center" FontWeight="Bold" />
                    <Button Content="تغییر رمز عبور" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GoChangePasswordCommand}" Margin="12,0,0,0" />
                    <Button Content="بستن" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DismissWarningCommand}" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
