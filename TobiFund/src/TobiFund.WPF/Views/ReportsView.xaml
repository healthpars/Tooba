<UserControl x:Class="TobiFund.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TobiFund.WPF.Controls"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="گزارش‌ها" Style="{StaticResource PageTitle}" />

        <!-- فیلترها -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="نوع گزارش" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="200" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding ReportTypes}"
                                  SelectedIndex="{Binding SelectedReportTypeIndex}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="از تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                        <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding FromDate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="تا تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                        <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding ToDate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0" Orientation="Horizontal">
                        <CheckBox Content="فیلتر بر اساس عضو" IsChecked="{Binding UseMemberFilter}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="200" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding Members}"
                                  DisplayMemberPath="FullName"
                                  SelectedItem="{Binding SelectedMember}"
                                  IsEnabled="{Binding UseMemberFilter}" />
                    </StackPanel>
                    <Button Content="بارگذاری گزارش" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoadReportCommand}" Margin="8,20,8,0" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="🖨️ چاپ" Command="{Binding PrintCommand}" />
                    <Button Content="📊 Export Excel" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportExcelCommand}" />
                    <Button Content="📄 Export PDF" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportPdfCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- نتایج -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <!-- 0: لیست اعضا -->
                <DataGrid ItemsSource="{Binding MembersResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شناسه" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام" Binding="{Binding FirstName}" Width="*" />
                        <DataGridTextColumn Header="نام خانوادگی" Binding="{Binding LastName}" Width="*" />
                        <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="*" />
                        <DataGridTextColumn Header="تاریخ عضویت" Binding="{Binding JoinDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                        <DataGridTextColumn Header="سرمایه" Binding="{Binding TotalCapital, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="مانده وام" Binding="{Binding OutstandingLoan, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="اقساط معوق" Binding="{Binding DueInstallments, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="آبونمان معوق" Binding="{Binding DueSubscription, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="امتیاز" Binding="{Binding TotalScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="رتبه" Binding="{Binding Rank, Converter={StaticResource PersianNumber}}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 1: گردش سرمایه -->
                <DataGrid ItemsSource="{Binding CapitalResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding TransactionDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="نوع" Binding="{Binding TypeName}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="ثبت‌کننده" Binding="{Binding CreatedBy}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 2: وام‌ها -->
                <DataGrid ItemsSource="{Binding LoansResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding LoanDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="مبلغ وام" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="تعداد اقساط" Binding="{Binding InstallmentCount, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ قسط" Binding="{Binding InstallmentAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 3: اقساط -->
                <DataGrid ItemsSource="{Binding InstallmentsResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="شماره قسط" Binding="{Binding InstallmentNumber, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 4: آبونمان -->
                <DataGrid ItemsSource="{Binding SubscriptionsResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="سال/ماه" Binding="{Binding YearMonth}" Width="Auto" />
                        <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 5: رتبه‌بندی -->
                <DataGrid ItemsSource="{Binding RankingResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=5}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رتبه" Binding="{Binding Rank, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="سرمایه" Binding="{Binding TotalCapital, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="وام" Binding="{Binding OutstandingLoan, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="اقساط معوق" Binding="{Binding DueInstallments, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="آبونمان معوق" Binding="{Binding DueSubscription, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="امتیاز" Binding="{Binding TotalScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 6: رویدادها -->
                <DataGrid ItemsSource="{Binding AuditResult}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding SelectedReportTypeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=6}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAtPersian}" Width="Auto" />
                        <DataGridTextColumn Header="کاربر" Binding="{Binding Username}" Width="Auto" />
                        <DataGridTextColumn Header="عملیات" Binding="{Binding Action}" Width="Auto" />
                        <DataGridTextColumn Header="نوع موجودیت" Binding="{Binding EntityType}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه" Binding="{Binding EntityId}" Width="Auto" />
                        <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
