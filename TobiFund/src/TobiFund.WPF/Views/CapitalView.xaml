<UserControl x:Class="TobiFund.WPF.Views.CapitalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TobiFund.WPF.Controls"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="سرمایه — پرداخت سرمایه و گردش سرمایه" Style="{StaticResource PageTitle}" />

        <!-- فرم پرداخت سرمایه -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="عضو" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="220" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding Members}"
                                  DisplayMemberPath="FullName"
                                  SelectedItem="{Binding SelectedMember}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="مبلغ" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                        <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding TransactionDate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="نوع تراکنش" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="130" Style="{StaticResource ComboBoxStyle}" SelectedIndex="{Binding TypeIndex}">
                            <ComboBoxItem>واریز</ComboBoxItem>
                            <ComboBoxItem>برداشت</ComboBoxItem>
                            <ComboBoxItem>تعدیل</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="220" Style="{StaticResource TextBoxStyle}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="ثبت تراکنش" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCommand}" Margin="8,20,8,0" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="#2E7D32"
                           Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- فیلتر + جدول گردش سرمایه -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,6,4">
                <TextBlock Text="گردش سرمایه — فیلتر:" VerticalAlignment="Center" Margin="6,0" />
                <ComboBox Width="220" Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding Members}"
                          DisplayMemberPath="FullName"
                          SelectedItem="{Binding SelectedMember}" />
                <Button Content="نمایش تراکنش‌های عضو" Command="{Binding FilterCommand}" />
                <Button Content="نمایش همه" Command="{Binding ShowAllCommand}" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <DataGrid ItemsSource="{Binding Transactions}" Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding TransactionDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="نوع" Binding="{Binding TypeName}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="ثبت‌کننده" Binding="{Binding CreatedBy}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
