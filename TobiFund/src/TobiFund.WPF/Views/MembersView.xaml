<UserControl x:Class="TobiFund.WPF.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TobiFund.WPF.Controls"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- عنوان + جستجو -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="مدیریت اعضا" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="320" Style="{StaticResource TextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="جستجو بر اساس نام، نام خانوادگی، شناسه یا شماره تماس" />
                <Button Content="جستجو" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCommand}" />
                <Button Content="عضو جدید" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewCommand}" />
                <Button Content="واردات اکسل" Style="{StaticResource AccentButtonStyle}" Command="{Binding ImportExcelCommand}"
                        ToolTip="خواندن فایل اکسل — ستون‌ها: شناسه، نام، نام خانوادگی، سرمایه، وام" />
                <Button Content="ویرایش" Command="{Binding EditSelectedCommand}" />
                <Button Content="جزئیات" Command="{Binding OpenDetailCommand}" />
                <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteSelectedCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- جدول اعضا -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Members}"
                      SelectedItem="{Binding SelectedMember}"
                      Style="{StaticResource DataGridStyle}"
                      MouseDoubleClick="MembersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شناسه" Binding="{Binding MemberCode}" Width="Auto" />
                    <DataGridTextColumn Header="نام" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn Header="نام خانوادگی" Binding="{Binding LastName}" Width="*" />
                    <DataGridTextColumn Header="شماره تماس" Binding="{Binding Phone}" Width="*" />
                    <DataGridTextColumn Header="تاریخ عضویت" Binding="{Binding JoinDatePersian}" Width="Auto" />
                    <DataGridTextColumn Header="سرمایه" Binding="{Binding TotalCapital, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="مانده وام" Binding="{Binding OutstandingLoan, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="اقساط معوق" Binding="{Binding DueInstallments, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="آبونمان معوق" Binding="{Binding DueSubscription, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="امتیاز" Binding="{Binding TotalScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                    <DataGridTextColumn Header="رتبه" Binding="{Binding Rank, Converter={StaticResource PersianNumber}}" Width="Auto" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- فرم عضو -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}"
                           Text="{Binding EditingMemberId, TargetNullValue='عضو جدید', StringFormat='ویرایش عضو با شناسه {0}'}" />
                <WrapPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="شناسه عضویت" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="140" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding MemberCode, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolean}}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="نام" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="160" Style="{StaticResource TextBoxStyle}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="نام خانوادگی" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="160" Style="{StaticResource TextBoxStyle}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="شماره تماس" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="160" Style="{StaticResource TextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="تاریخ عضویت (شمسی)" Style="{StaticResource FieldLabel}" />
                        <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding JoinDate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="وضعیت" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="120" Style="{StaticResource ComboBoxStyle}" SelectedIndex="{Binding StatusIndex}">
                            <ComboBoxItem>فعال</ComboBoxItem>
                            <ComboBoxItem>غیرفعال</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="220" Style="{StaticResource TextBoxStyle}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="ذخیره" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                    <Button Content="انصراف" Command="{Binding NewCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding FormMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
