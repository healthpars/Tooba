<UserControl x:Class="TobiFund.WPF.Views.RankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="رتبه‌بندی اعضا (بر اساس امتیاز کل)" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
            <Button Content="بازخوانی" Command="{Binding LoadCommand}" VerticalAlignment="Top" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Ranking}"
                      SelectedItem="{Binding SelectedRanking}"
                      Style="{StaticResource DataGridStyle}"
                      MouseDoubleClick="Ranking_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رتبه" Binding="{Binding Rank, Converter={StaticResource PersianNumber}}" Width="Auto" />
                    <DataGridTextColumn Header="شناسه" Binding="{Binding MemberCode}" Width="Auto" />
                    <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="سرمایه" Binding="{Binding TotalCapital, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="وام" Binding="{Binding OutstandingLoan, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="اقساط معوق" Binding="{Binding DueInstallments, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="آبونمان معوق" Binding="{Binding DueSubscription, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="امتیاز" Binding="{Binding TotalScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
