<UserControl x:Class="TobiFund.WPF.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="پشتیبان‌گیری و بازیابی (فقط مدیر)" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="مسیر دیتابیس:" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Text="{Binding DatabasePathText}" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 پشتیبان‌گیری" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding BackupCommand}" />
                    <Button Content="♻️ بازیابی از فایل انتخاب‌شده / انتخاب فایل" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding RestoreCommand}" />
                    <Button Content="بازخوانی فهرست" Command="{Binding LoadCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="#2E7D32"
                           Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="فایل‌های پشتیبان موجود" Style="{StaticResource SectionTitle}" Margin="6,0,6,0" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding BackupFiles}"
                         SelectedItem="{Binding SelectedBackupFile}"
                         FontSize="13" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
