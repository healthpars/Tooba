<UserControl x:Class="TobiFund.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="داشبورد" Style="{StaticResource PageTitle}" />

            <!-- آمار کلی -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalMembers, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="تعداد اعضا" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.ActiveMembers, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="تعداد اعضای فعال" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalCapital, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="مجموع سرمایه اعضا" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalLoans, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="مجموع وام‌ها" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalDueInstallments, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="مجموع اقساط پرداخت‌نشده" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalDueSubscriptions, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="مجموع آبونمان‌های معوق" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalScore, Converter={StaticResource PersianNumber}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="مجموع امتیاز اعضا" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- اعضای برتر -->
            <TextBlock Text="اعضای برتر (بر اساس امتیاز)" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource CardStyle}">
                <DataGrid ItemsSource="{Binding TopMembers}"
                          SelectedItem="{Binding SelectedTopMember}"
                          Style="{StaticResource DataGridStyle}"
                          MaxHeight="280"
                          MouseDoubleClick="TopMembers_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رتبه" Binding="{Binding Rank, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه" Binding="{Binding MemberCode}" Width="*" />
                        <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="سرمایه" Binding="{Binding TotalCapital, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="وام" Binding="{Binding OutstandingLoan, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="امتیاز" Binding="{Binding TotalScore, Converter={StaticResource PersianNumber}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- هشدارها -->
            <TextBlock Text="هشدارها" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource CardStyle}">
                <DataGrid ItemsSource="{Binding Alerts}"
                          Style="{StaticResource DataGridStyle}"
                          MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نوع" Binding="{Binding Title}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="توضیحات" Binding="{Binding Message}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
