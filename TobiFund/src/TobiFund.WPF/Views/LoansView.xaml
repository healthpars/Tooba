<UserControl x:Class="TobiFund.WPF.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TobiFund.WPF.Controls"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="وام — ثبت وام و لیست وام‌ها" Style="{StaticResource PageTitle}" />

        <!-- فرم ثبت وام -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="عضو" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="220" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding Members}"
                                  DisplayMemberPath="FullName"
                                  SelectedItem="{Binding SelectedMember}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="مبلغ وام" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="تاریخ دریافت (شمسی)" Style="{StaticResource FieldLabel}" />
                        <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding LoanDate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="تعداد اقساط" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="90" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding InstallmentCountText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsInstallmentCountEditable}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="200" Style="{StaticResource TextBoxStyle}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="ثبت وام" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateLoanCommand}" Margin="8,20,8,0" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="#2E7D32"
                           Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- لیست وام‌ها -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="لیست وام‌ها (برای مشاهده اقساط، روی یک وام کلیک کنید)" Style="{StaticResource SectionTitle}" Margin="6,0,6,0" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Loans}"
                          SelectedItem="{Binding SelectedLoan}"
                          Style="{StaticResource DataGridStyle}"
                          SelectionChanged="LoansGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding LoanDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                        <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="مبلغ وام" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="تعداد اقساط" Binding="{Binding InstallmentCount, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ قسط" Binding="{Binding InstallmentAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- اقساط وام انتخاب‌شده -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="اقساط وام انتخاب‌شده" Style="{StaticResource SectionTitle}" Margin="6,0,6,0" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Installments}"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره" Binding="{Binding InstallmentNumber, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
