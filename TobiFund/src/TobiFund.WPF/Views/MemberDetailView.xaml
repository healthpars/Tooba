<UserControl x:Class="TobiFund.WPF.Views.MemberDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TobiFund.WPF.Controls"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- هدر -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="← بازگشت" Command="{Binding BackCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0"
                           Foreground="#2E7D32"
                           Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Content="بازخوانی" Command="{Binding LoadAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- خلاصه عضو -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <WrapPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="سرمایه کل" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.TotalCapital, Converter={StaticResource PersianNumber}}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="وام" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.TotalLoan, Converter={StaticResource PersianNumber}}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="مانده وام" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.OutstandingLoan, Converter={StaticResource PersianNumber}}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="قسط ماهانه" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.MonthlyInstallment, Converter={StaticResource PersianNumber}}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="اقساط معوق" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.DueInstallments, Converter={StaticResource PersianNumber}}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="آبونمان معوق" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.DueSubscription, Converter={StaticResource PersianNumber}}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="امتیاز" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.TotalScore, Converter={StaticResource PersianNumber}}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="10,4">
                    <TextBlock Text="رتبه" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Summary.Rank, Converter={StaticResource PersianNumber}}" FontWeight="Bold" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- تب‌ها -->
        <TabControl Grid.Row="2" Margin="6">
            <!-- اطلاعات اصلی -->
            <TabItem Header="اطلاعات اصلی">
                <Border Style="{StaticResource CardStyle}">
                    <WrapPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="نام" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.FirstName}" FontWeight="Bold" /></StackPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="نام خانوادگی" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.LastName}" FontWeight="Bold" /></StackPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="شناسه" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.MemberCode}" FontWeight="Bold" /></StackPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="شماره تماس" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.Phone}" FontWeight="Bold" /></StackPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="تاریخ عضویت" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.JoinDatePersian}" FontWeight="Bold" /></StackPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="وضعیت" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.StatusName}" FontWeight="Bold" /></StackPanel>
                        <StackPanel Margin="10,6"><TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Member.Notes}" FontWeight="Bold" /></StackPanel>
                    </WrapPanel>
                </Border>
            </TabItem>

            <!-- سرمایه -->
            <TabItem Header="سرمایه">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <WrapPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="مبلغ" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding CapitalAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                                <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding CapitalDate}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="نوع" Style="{StaticResource FieldLabel}" />
                                <ComboBox Width="120" Style="{StaticResource ComboBoxStyle}" SelectedIndex="{Binding CapitalTypeIndex}">
                                    <ComboBoxItem>واریز</ComboBoxItem>
                                    <ComboBoxItem>برداشت</ComboBoxItem>
                                    <ComboBoxItem>تعدیل</ComboBoxItem>
                                </ComboBox></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="200" Style="{StaticResource TextBoxStyle}" Text="{Binding CapitalDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <Button Content="ثبت پرداخت سرمایه" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddCapitalCommand}" Margin="8,20,8,0" />
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <DataGrid ItemsSource="{Binding CapitalTransactions}" Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding TransactionDatePersian}" Width="Auto" />
                                <DataGridTextColumn Header="نوع" Binding="{Binding TypeName}" Width="Auto" />
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="ثبت‌کننده" Binding="{Binding CreatedBy}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- وام‌ها -->
            <TabItem Header="وام‌ها">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <WrapPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="مبلغ وام" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding LoanAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="تاریخ دریافت (شمسی)" Style="{StaticResource FieldLabel}" />
                                <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding LoanDate}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="تعداد اقساط" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="90" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding LoanInstallmentCountText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsInstallmentCountEditable}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="180" Style="{StaticResource TextBoxStyle}" Text="{Binding LoanDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <Button Content="ثبت وام" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CreateLoanCommand}" Margin="8,20,8,0" />
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <DataGrid ItemsSource="{Binding Loans}" Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding LoanDatePersian}" Width="Auto" />
                                <DataGridTextColumn Header="مبلغ وام" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="تعداد اقساط" Binding="{Binding InstallmentCount, Converter={StaticResource PersianNumber}}" Width="Auto" />
                                <DataGridTextColumn Header="مبلغ قسط" Binding="{Binding InstallmentAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- اقساط -->
            <TabItem Header="اقساط">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <DataGrid ItemsSource="{Binding Installments}"
                                  SelectedItem="{Binding SelectedInstallment}"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding InstallmentNumber, Converter={StaticResource PersianNumber}}" Width="Auto" />
                                <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <WrapPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="مبلغ پرداختی" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding InstallmentPayAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="تاریخ پرداخت (شمسی)" Style="{StaticResource FieldLabel}" />
                                <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding InstallmentPayDate}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="200" Style="{StaticResource TextBoxStyle}" Text="{Binding InstallmentPayDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <Button Content="پرداخت قسط انتخاب‌شده" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PayInstallmentCommand}" Margin="8,20,8,0" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- آبونمان -->
            <TabItem Header="آبونمان">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <DataGrid ItemsSource="{Binding Subscriptions}"
                                  SelectedItem="{Binding SelectedSubscription}"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="سال/ماه" Binding="{Binding YearMonth}" Width="Auto" />
                                <DataGridTextColumn Header="ماه" Binding="{Binding MonthName}" Width="Auto" />
                                <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="سال شمسی:" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Width="100" Style="{StaticResource TextBoxStyle}" Text="{Binding SubscriptionYearText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="ایجاد ۱۲ آبونمان برای سال" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding GenerateSubscriptionsCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <WrapPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="مبلغ پرداختی" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding SubscriptionPayAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="تاریخ پرداخت (شمسی)" Style="{StaticResource FieldLabel}" />
                                <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding SubscriptionPayDate}" /></StackPanel>
                            <StackPanel Margin="8,0"><TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="200" Style="{StaticResource TextBoxStyle}" Text="{Binding SubscriptionPayDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <Button Content="پرداخت آبونمان انتخاب‌شده" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PaySubscriptionCommand}" Margin="8,20,8,0" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- امتیازات -->
            <TabItem Header="امتیازات">
                <Border Style="{StaticResource CardStyle}" Margin="6">
                    <DataGrid ItemsSource="{Binding DailyScores}" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding ScoreDatePersian}" Width="Auto" />
                            <DataGridTextColumn Header="سرمایه" Binding="{Binding CapitalAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                            <DataGridTextColumn Header="وام" Binding="{Binding LoanAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                            <DataGridTextColumn Header="مثبت" Binding="{Binding PositiveScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                            <DataGridTextColumn Header="منفی" Binding="{Binding NegativeScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                            <DataGridTextColumn Header="خالص" Binding="{Binding NetScore, Converter={StaticResource PersianNumber}}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- گردش مالی -->
            <TabItem Header="گردش مالی">
                <Border Style="{StaticResource CardStyle}" Margin="6">
                    <DataGrid ItemsSource="{Binding CapitalTransactions}" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding TransactionDatePersian}" Width="Auto" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeName}" Width="Auto" />
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                            <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="ثبت‌کننده" Binding="{Binding CreatedBy}" Width="Auto" />
                            <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding CreatedAt, Converter={StaticResource PersianDate}, ConverterParameter=datetime}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
