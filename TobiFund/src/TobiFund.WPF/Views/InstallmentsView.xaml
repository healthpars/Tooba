<UserControl x:Class="TobiFund.WPF.Views.InstallmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TobiFund.WPF.Controls"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="اقساط — مدیریت و پرداخت اقساط وام" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="فیلتر وضعیت:" VerticalAlignment="Center" Margin="6,0" />
                <ComboBox Width="180" Style="{StaticResource ComboBoxStyle}" SelectedIndex="{Binding StatusFilterIndex}">
                    <ComboBoxItem>همه</ComboBoxItem>
                    <ComboBoxItem>آینده</ComboBoxItem>
                    <ComboBoxItem>سررسید</ComboBoxItem>
                    <ComboBoxItem>پرداخت جزئی</ComboBoxItem>
                    <ComboBoxItem>پرداخت شده</ComboBoxItem>
                    <ComboBoxItem>معوق</ComboBoxItem>
                </ComboBox>
                <Button Content="بازخوانی" Command="{Binding LoadCommand}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Installments}"
                      SelectedItem="{Binding SelectedInstallment}"
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شناسه عضو" Binding="{Binding MemberCode}" Width="Auto" />
                    <DataGridTextColumn Header="نام عضو" Binding="{Binding MemberName}" Width="*" />
                    <DataGridTextColumn Header="شماره قسط" Binding="{Binding InstallmentNumber, Converter={StaticResource PersianNumber}}" Width="Auto" />
                    <DataGridTextColumn Header="سررسید" Binding="{Binding DueDatePersian}" Width="Auto" />
                    <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, Converter={StaticResource PersianNumber}}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="مبلغ پرداختی" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="150" Style="{StaticResource TextBoxStyle}" Text="{Binding PayAmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="تاریخ پرداخت (شمسی)" Style="{StaticResource FieldLabel}" />
                        <controls:PersianDatePicker Width="150" Margin="0,4,0,8" SelectedDate="{Binding PayDate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="220" Style="{StaticResource TextBoxStyle}" Text="{Binding PayDescription, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="پرداخت قسط انتخاب‌شده" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding PayCommand}" Margin="8,20,8,0" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="#2E7D32"
                           Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
