<Window x:Class="TobiFund.WPF.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:TobiFund.WPF.Helpers"
        Title="تغییر رمز عبور"
        Width="400" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource BackgroundBrush}" Padding="24">
        <StackPanel>
            <TextBlock Text="تغییر رمز عبور" Style="{StaticResource PageTitle}" />

            <TextBlock Text="رمز عبور فعلی" Style="{StaticResource FieldLabel}" />
            <PasswordBox Style="{StaticResource PasswordBoxStyle}"
                         h:PasswordBoxAssistant.BoundPassword="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="رمز عبور جدید" Style="{StaticResource FieldLabel}" />
            <PasswordBox Style="{StaticResource PasswordBoxStyle}"
                         h:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="تکرار رمز عبور جدید" Style="{StaticResource FieldLabel}" />
            <PasswordBox Style="{StaticResource PasswordBoxStyle}"
                         h:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding Message}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,6" MinHeight="18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="ذخیره" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" IsDefault="True" />
                <Button Content="انصراف" Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
